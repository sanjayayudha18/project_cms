# Normalize line endings to LF for all text files, regardless of platform
# checkout settings (avoids CRLF drift on Windows checkouts, which caused
# repo-wide `pnpm lint` / biome formatter failures).
* text=auto eol=lf

# Windows-specific scripts genuinely need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — no line-ending processing.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
