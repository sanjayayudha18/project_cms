# ---------- Go (backend) ----------
# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
/bin/
/build/
/dist/

# Test & coverage
*.test
*.out
coverage.*

# Go workspace file (go.work, go.work.sum) is committed: Dockerfiles COPY it and it pins the toolchain.

# Vendor (uncomment if you don't vendor deps)
# /vendor/

# ---------- Node / React / Vite (frontend) ----------
node_modules/
dist/
dist-ssr/
*.local

# Vite / build caches
.vite/
.cache/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# ---------- Environment & secrets ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Docker ----------
# (keep Dockerfile & compose tracked; ignore local overrides)
docker-compose.override.yml

# ---------- Editors / OS ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- Kiro ----------
# keep specs/steering tracked; ignore local agent scratch if any
.kiro/**/local/

# ---------- Document ----------
/archives/
/clickups prototype html+css/
FTP_DATA/
DSR_DATA/
# archived migrations: files already tracked stay tracked; new/local ones (incl. bak_*.sql DB dumps) stay out
backend/migrations/archives/

# ---------- Python ----------
__pycache__/
*.pyc
.venv/
venv/

# ---------- Coverage / TS build info ----------
coverage/
*.tsbuildinfo

# ---------- Claude / OpenCode local state ----------
.claude/settings.local.json
.claude/dev-credentials.local
.claude/worktrees/
.opencode/node_modules/

# ---------- graphify ----------
# keep graph.json, GRAPH_REPORT.md, manifest.json; cache + dated snapshots are regenerated by `graphify update .`
graphify-out/cache/
graphify-out/20*/
graphify-out/graph.html
graphify-out/cost.json

# Office lock files (created while a document is open in Excel/Word)
~$*
