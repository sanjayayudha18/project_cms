# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

APP_ENV=development
PORT=8081
# Parsed by pkg/config but not used yet (no IP-aware middleware in backend-exq, QC F13).
TRUSTED_PROXIES=
DATABASE_URL=postgres://user:pass@host.docker.internal:5432/cms
# DATABASE_REPLICA_URL=postgres://user:pass@replica-host:5432/cms

# Must match backend/.env's JWT_SECRET exactly — backend-exq only validates
# tokens, backend is the sole issuer.
JWT_SECRET=change_me

# container_name on the shared `cms-net` external network (see root docker-compose.yml)
REDIS_URL=redis://cms-redis:6379

LOG_LEVEL=info
