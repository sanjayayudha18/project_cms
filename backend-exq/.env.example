# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

APP_ENV=development
PORT=8081
# Proxies (Nginx) whose X-Forwarded-For is trusted for the client IP (audit). Comma-separated CIDR/IP.
# Must contain the CompanyPortal Nginx address in prod; empty = every user appears as the proxy IP.
TRUSTED_PROXIES=
DATABASE_URL=postgres://user:pass@host.docker.internal:5432/cms
# Read replica for export reads; unset = reuse DATABASE_URL.
# DATABASE_REPLICA_URL=postgres://user:pass@replica-host:5432/cms

# Must match backend/.env's JWT_SECRET exactly — backend-exq only validates
# tokens, backend is the sole issuer.
JWT_SECRET=change_me

# container_name on the shared `cms-net` external network (see root docker-compose.yml)
REDIS_URL=redis://cms-redis:6379

LOG_LEVEL=info

# Export worker (vendor-data-export)
EXPORT_WORKERS=2                 # parallel worker goroutines per instance (1-8)
EXPORT_POLL_INTERVAL=2s          # queue poll interval when no wake-up signal (> 0)
EXPORT_JANITOR_INTERVAL=30s      # janitor interval, max 1m (service refuses to start above)
