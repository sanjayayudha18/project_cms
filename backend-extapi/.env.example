# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

APP_ENV=development
PORT=8082
# Proxies (Nginx / GCP LB) whose X-Forwarded-For is trusted for the client IP. Comma-separated CIDR/IP.
TRUSTED_PROXIES=
DATABASE_URL=postgres://user:pass@host.docker.internal:5432/cms
REDIS_URL=redis://cms-redis:6379

# Signing key for external-API tokens, at least 32 bytes. Must DIFFER from the internal JWT_SECRET.
EXT_JWT_SECRET=change_me_to_at_least_32_bytes_long_value
# JWT_SECRET must NOT be set in this service: the internal key never enters backend-extapi
# (the service refuses to start if it is present).

LOG_LEVEL=info
