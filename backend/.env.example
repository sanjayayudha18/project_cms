# ─── Backend Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Server
PORT=8080

# Auth
JWT_SECRET=change-me-minimum-32-bytes-long!!
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h

# Database (primary — writes)
DATABASE_URL=postgres://postgres:password@host.docker.internal:5432/cms?sslmode=disable

# Database (replica — reads/reporting)
# DATABASE_REPLICA_URL=postgres://postgres:password@replica-host:5432/cms?sslmode=disable

# Redis (container_name on the shared `cms-net` external network — see root docker-compose.yml)
REDIS_URL=redis://cms-redis:6379

# Rate Limiting
RATE_LIMIT_USERNAME=5
RATE_LIMIT_IP=20
RATE_LIMIT_WINDOW=15m

# LDAP (internal auth)
# LDAP_URL=ldap://ldap.company.local:389
# LDAP_BASE_DN=dc=company,dc=local
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=

# SMTP (notifications)
# SMTP_HOST=smtp.company.local
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=cms-noreply@company.co.id

# Logging
LOG_LEVEL=info
