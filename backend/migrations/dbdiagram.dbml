// =============================================================================
// CMS ATM & CIT — Database Diagram (dbdiagram.io DBML format)
// Paste this into https://dbdiagram.io/d
// =============================================================================

// =============================================================================
// AUTH GROUP
// =============================================================================

Table roles {
  id bigint [pk, increment]
  name text [not null, unique]
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table users {
  id bigint [pk, increment]
  employee_id text [unique]
  username text [not null, unique]
  full_name text [not null]
  email text [not null]
  auth_source text [not null, note: 'ldap | local']
  password_hash text
  role_id bigint [not null, ref: > roles.id]
  vendor_id bigint [ref: > vendors.id]
  is_active boolean [not null, default: true]
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

// =============================================================================
// MASTER DATA GROUP
// =============================================================================

Table vendors {
  id bigint [pk, increment]
  code text [not null, unique]
  name text [not null]
  contact_email text
  contact_phone text
  address text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table vendor_pics {
  id bigint [pk, increment]
  vendor_id bigint [not null, ref: > vendors.id]
  full_name text [not null]
  email text
  phone text
  position text
  is_primary boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table locations {
  id bigint [pk, increment]
  code text [not null, unique]
  name text [not null]
  region text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table vendor_vaults {
  id bigint [pk, increment]
  vendor_id bigint [not null, ref: > vendors.id]
  location_id bigint [not null, ref: > locations.id]
  vault_code text [not null, unique]
  address text
  capacity numeric
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table atms {
  id bigint [pk, increment]
  terminal_id text [not null, unique]
  location_name text [not null]
  address text
  location_id bigint [not null, ref: > locations.id]
  vendor_id bigint [not null, ref: > vendors.id]
  vault_id bigint [ref: > vendor_vaults.id]
  machine_type text [default: 'ATM', note: 'ATM | CRM']
  capacity numeric
  low_threshold numeric
  critical_threshold numeric
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table vendor_assignments {
  id bigint [pk, increment]
  vendor_id bigint [not null, ref: > vendors.id]
  atm_id bigint [not null, ref: > atms.id]
  assigned_at timestamptz [not null, default: `now()`]
  unassigned_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

// =============================================================================
// CORE GROUP
// =============================================================================

Table audit_logs {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  action text [not null]
  entity_type text [not null]
  entity_id bigint
  before_state jsonb
  after_state jsonb
  ip_address inet
  user_agent text
  metadata jsonb
  created_at timestamptz [not null, default: `now()`]
}

Table approval_requests {
  id bigint [pk, increment]
  entity_type text [not null]
  entity_id bigint [not null]
  action text [not null]
  status text [not null, default: 'pending', note: 'pending | approved | rejected']
  maker_id bigint [not null, ref: > users.id]
  checker_id bigint [ref: > users.id]
  request_data jsonb [not null]
  rejection_reason text
  requested_at timestamptz [not null, default: `now()`]
  decided_at timestamptz
}

Table documents {
  id bigint [pk, increment]
  entity_type text [not null]
  entity_id bigint [not null]
  file_name text [not null]
  file_path text [not null]
  file_size bigint
  mime_type text
  uploaded_by bigint [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
}

Table notifications {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  title text [not null]
  body text
  category text [not null]
  entity_type text
  entity_id bigint
  is_read boolean [not null, default: false]
  read_at timestamptz
  channel text [not null, default: 'in_app', note: 'in_app | email | both']
  sent_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table import_jobs {
  id bigint [pk, increment]
  job_type text [not null]
  file_name text [not null]
  file_hash text [not null]
  file_path text
  status text [not null, default: 'processing', note: 'processing | success | failed | duplicate']
  rows_processed integer [default: 0]
  rows_failed integer [default: 0]
  error_details jsonb
  uploaded_by bigint [not null, ref: > users.id]
  started_at timestamptz [not null, default: `now()`]
  finished_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table export_jobs {
  id bigint [pk, increment]
  job_type text [not null]
  format text [not null, default: 'xlsx', note: 'xlsx | csv | pdf']
  status text [not null, default: 'processing', note: 'processing | success | failed']
  file_path text
  parameters jsonb
  requested_by bigint [not null, ref: > users.id]
  started_at timestamptz [not null, default: `now()`]
  finished_at timestamptz
  expires_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

// =============================================================================
// ATM OPERATIONS GROUP
// =============================================================================

Table atm_dsr_uploads {
  id bigint [pk, increment]
  import_job_id bigint [not null, ref: > import_jobs.id]
  report_date date [not null]
  vendor_id bigint [not null, ref: > vendors.id]
  total_rows integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
}

Table atm_dsr_rows {
  id bigint [pk, increment]
  upload_id bigint [not null, ref: > atm_dsr_uploads.id]
  atm_id bigint [not null, ref: > atms.id]
  report_date date [not null]
  beginning_balance numeric [not null]
  cash_in numeric [not null, default: 0]
  cash_out numeric [not null, default: 0]
  ending_balance numeric [not null]
  status text [not null, default: 'normal', note: 'normal | low | critical']
  created_at timestamptz [not null, default: `now()`]
}

Table forecast_runs {
  id bigint [pk, increment]
  processing_date date [not null]
  status text [not null, default: 'running', note: 'running | success | failed']
  horizon_days integer [not null, default: 2]
  records_processed integer [default: 0]
  error_details text
  started_at timestamptz [not null, default: `now()`]
  finished_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table forecast_results {
  id bigint [pk, increment]
  run_id bigint [not null, ref: > forecast_runs.id]
  atm_id bigint [not null, ref: > atms.id]
  processing_date date [not null]
  current_balance numeric [not null]
  predicted_usage_h1 numeric [not null, default: 0]
  predicted_usage_h2 numeric [not null, default: 0]
  recommended_replenishment numeric [not null, default: 0]
  priority text [not null, default: 'low', note: 'low | medium | high']
  created_at timestamptz [not null, default: `now()`]
}

Table replenishment_instructions {
  id bigint [pk, increment]
  forecast_result_id bigint [ref: > forecast_results.id]
  atm_id bigint [not null, ref: > atms.id]
  vendor_id bigint [not null, ref: > vendors.id]
  scheduled_date date [not null]
  amount numeric [not null]
  route_code text
  window_start time
  window_end time
  status text [not null, default: 'scheduled', note: 'scheduled | pending_vendor | in_transit | completed | delayed | cancelled']
  origin text [not null, default: 'auto', note: 'auto | manual']
  completed_at timestamptz
  notes text
  created_by bigint [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// =============================================================================
// CIT GROUP
// =============================================================================

Table cit_orders {
  id bigint [pk, increment]
  order_code text [not null, unique]
  atm_id bigint [not null, ref: > atms.id]
  vendor_id bigint [not null, ref: > vendors.id]
  order_date date [not null]
  scheduled_date date [not null]
  amount numeric [not null]
  status text [not null, default: 'scheduled', note: 'scheduled | in_transit | completed | failed | cancelled']
  origin text [not null, default: 'auto', note: 'auto | manual']
  failure_reason text
  completed_at timestamptz
  created_by bigint [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table cit_handover_evidences {
  id bigint [pk, increment]
  cit_order_id bigint [not null, ref: > cit_orders.id]
  evidence_type text [not null, default: 'photo', note: 'photo | pdf | signature']
  file_path text [not null]
  file_name text
  uploaded_by bigint [not null, ref: > users.id]
  notes text
  created_at timestamptz [not null, default: `now()`]
}

Table cit_journals {
  id bigint [pk, increment]
  cit_order_id bigint [not null, ref: > cit_orders.id]
  atm_id bigint [not null, ref: > atms.id]
  journal_date date [not null]
  amount_loaded numeric [not null]
  amount_retrieved numeric [not null, default: 0]
  net_change numeric [note: 'generated: amount_loaded - amount_retrieved']
  operator_name text
  notes text
  created_at timestamptz [not null, default: `now()`]
}

Table cit_dsr_uploads {
  id bigint [pk, increment]
  import_job_id bigint [not null, ref: > import_jobs.id]
  report_date date [not null]
  vendor_id bigint [not null, ref: > vendors.id]
  total_rows integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
}

Table cit_reconciliation_results {
  id bigint [pk, increment]
  cit_order_id bigint [not null, ref: > cit_orders.id]
  dsr_row_id bigint [ref: > atm_dsr_rows.id]
  journal_id bigint [ref: > cit_journals.id]
  order_amount numeric [not null]
  dsr_amount numeric
  journal_amount numeric
  variance numeric [not null, default: 0]
  status text [not null, default: 'open', note: 'open | matched | exception | resolved']
  resolved_by bigint [ref: > users.id]
  resolved_at timestamptz
  resolution_note text
  created_at timestamptz [not null, default: `now()`]
}

// =============================================================================
// FINANCE GROUP
// =============================================================================

Table invoice_uploads {
  id bigint [pk, increment]
  import_job_id bigint [ref: > import_jobs.id]
  vendor_id bigint [not null, ref: > vendors.id]
  invoice_number text [not null, unique]
  period_start date [not null]
  period_end date [not null]
  total_amount numeric [not null]
  line_items_count integer [not null, default: 0]
  validation_status text [not null, default: 'uploaded', note: 'uploaded | validated | mismatch_detected | approved | rejected']
  validator_id bigint [ref: > users.id]
  validated_at timestamptz
  approver_id bigint [ref: > users.id]
  approved_at timestamptz
  rejection_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table invoice_items {
  id bigint [pk, increment]
  invoice_id bigint [not null, ref: > invoice_uploads.id]
  description text [not null]
  invoiced_amount numeric [not null]
  matched_order_id bigint [ref: > cit_orders.id]
  expected_amount numeric
  variance numeric [not null, default: 0]
  match_status text [not null, default: 'pending_review', note: 'pending_review | matched | mismatch | unmatched']
  created_at timestamptz [not null, default: `now()`]
}

Table invoice_reconciliation_results {
  id bigint [pk, increment]
  invoice_id bigint [not null, ref: > invoice_uploads.id]
  total_invoiced numeric [not null]
  total_expected numeric [not null]
  total_variance numeric [not null, default: 0]
  matched_count integer [not null, default: 0]
  mismatch_count integer [not null, default: 0]
  unmatched_count integer [not null, default: 0]
  reconciled_at timestamptz [not null, default: `now()`]
  reconciled_by bigint [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
}

// =============================================================================
// INTEGRATION GROUP (escrow / corebanking)
// =============================================================================

Table escrow_batch_files {
  id bigint [pk, increment]
  import_job_id bigint [not null, ref: > import_jobs.id]
  file_date date [not null]
  file_hash text [not null, unique]
  total_rows integer [not null, default: 0]
  total_amount numeric [not null, default: 0]
  status text [not null, default: 'processing', note: 'processing | processed | failed']
  created_at timestamptz [not null, default: `now()`]
}

Table escrow_batch_rows {
  id bigint [pk, increment]
  batch_file_id bigint [not null, ref: > escrow_batch_files.id]
  atm_id bigint [ref: > atms.id]
  terminal_id_raw text [not null]
  transaction_date date [not null]
  escrow_balance numeric [not null]
  currency text [not null, default: 'IDR']
  row_number integer
  created_at timestamptz [not null, default: `now()`]
}

Table escrow_reconciliation_results {
  id bigint [pk, increment]
  batch_file_id bigint [not null, ref: > escrow_batch_files.id]
  atm_id bigint [not null, ref: > atms.id]
  reconciliation_date date [not null]
  cms_balance numeric [not null]
  escrow_balance numeric [not null]
  difference numeric [not null, default: 0]
  severity text [not null, default: 'low', note: 'low | medium | high']
  status text [not null, default: 'open', note: 'open | resolved | acknowledged']
  owner_id bigint [ref: > users.id]
  resolved_by bigint [ref: > users.id]
  resolved_at timestamptz
  resolution_note text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// =============================================================================
// EOD BATCH TRACKING
// =============================================================================

Table eod_runs {
  id bigint [pk, increment]
  processing_date date [not null]
  run_type text [not null, default: 'full', note: 'full | partial | retry']
  status text [not null, default: 'running', note: 'running | success | failed']
  steps_completed jsonb
  records_processed integer [default: 0]
  error_details text
  started_at timestamptz [not null, default: `now()`]
  finished_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

// =============================================================================
// TABLE GROUPS (for visual organization in dbdiagram.io)
// =============================================================================

TableGroup auth {
  roles
  users
}

TableGroup master_data {
  vendors
  vendor_pics
  locations
  vendor_vaults
  atms
  vendor_assignments
}

TableGroup core {
  audit_logs
  approval_requests
  documents
  notifications
  import_jobs
  export_jobs
}

TableGroup atm_operations {
  atm_dsr_uploads
  atm_dsr_rows
  forecast_runs
  forecast_results
  replenishment_instructions
}

TableGroup cit {
  cit_orders
  cit_handover_evidences
  cit_journals
  cit_dsr_uploads
  cit_reconciliation_results
}

TableGroup finance {
  invoice_uploads
  invoice_items
  invoice_reconciliation_results
}

TableGroup integration {
  escrow_batch_files
  escrow_batch_rows
  escrow_reconciliation_results
}

TableGroup batch {
  eod_runs
}
