# EOD Retry Scheduler configuration (dmaa, itm_cashpos, itm_replenish only --
# DSR moved to service_dsr_etl/.env.example). Copy to .env and fill in real values.
# All variables use the RETRY_ prefix (pydantic-settings env_prefix).

RETRY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cms?sslmode=disable
# Optional read replica for the monitoring APIs; empty = primary.
RETRY_DATABASE_REPLICA_URL=

# Required: the service refuses to start with an empty or "change_me" secret.
# jwt mode: same value as the Go JWT_SECRET; only ADMIN/APPACCESS access tokens may call monitoring + retry.
RETRY_AUTH_SECRET=change_me
RETRY_AUTH_MODE=api_key

RETRY_SLA_DMAA=06:00
RETRY_SLA_ITM_CASHPOS=07:00
RETRY_SLA_ITM_REPLENISH=07:00

RETRY_RETRY_INTERVAL_MINUTES=30
RETRY_MAX_AUTO_RETRIES=3
RETRY_STALE_AFTER_MINUTES=60
RETRY_DB_RETRY_MAX_ATTEMPTS=3
RETRY_DB_RETRY_BASE_DELAY_SECONDS=1.0

RETRY_SCAN_CRON_START_HOUR=5
RETRY_SCAN_CRON_END_HOUR=9
RETRY_SCAN_INTERVAL_MINUTES=15

RETRY_FTP_DATA_ROOT=FTP_DATA
# RETRY_DMAA_INPUT_DIR=
# RETRY_DMAA_NOT_PROCESSED_DIR=
# RETRY_ITM_CASHPOS_INPUT_DIR=
# RETRY_ITM_CASHPOS_NOT_PROCESSED_DIR=
# RETRY_ITM_REPLENISH_INPUT_DIR=
# RETRY_ITM_REPLENISH_NOT_PROCESSED_DIR=

RETRY_ETL_DMAA_SCRIPT=backend_python/dmaa/dmaa_etl.py
RETRY_ETL_ITM_CASHPOS_SCRIPT=backend_python/itm/cashpos/itm_cashpos_etl.py
RETRY_ETL_ITM_REPLENISH_SCRIPT=backend_python/itm/replenish/itm_replenish_etl.py

RETRY_SERVICE_VERSION=1.0.0
RETRY_LOG_LEVEL=INFO

# Proxies (Nginx) whose X-Forwarded-For is believed for the client IP of a
# manual retry (audit). Comma-separated CIDRs/IPs, e.g. 172.17.0.1/32 (same
# value as the Go TRUSTED_PROXIES). Empty = ignore the header. Invalid = fail start.
RETRY_TRUSTED_PROXIES=

# Replenishment realisasi classification (replenishment-realisasi FR3): tickets/ITM fills from this
# date (YYYY-MM-DD) on are classified after each ITM replenish file + daily 09:15 WIB. Empty = off
# (no historical backfill). Manual run: python -m replenish_classify.run [--date YYYY-MM-DD]
RETRY_REPLENISH_CLASSIFY_START_DATE=
# DSR telat (dsr-late-report FR5): vendor branches without a DSR for today are notified at 09:00 WIB,
# for report dates from this date (YYYY-MM-DD) on. MUST be the same in all three runtimes:
# backend + backend-exq (DSR_LATE_START_DATE) and this service (K5).
# Empty = job off (no backfill). Manual run: python -m dsr_late_notify.run [--date YYYY-MM-DD]
RETRY_DSR_LATE_START_DATE=
# true only where the Go API sends email (SMTP_HOST set); else late-report emails are stored as skipped.
RETRY_NOTIFY_EMAIL_ENABLED=false

# Host/container running this service and the ETL scripts MUST use TZ=Asia/Jakarta
# (DMAA file_date comes from file mtime in host TZ). Set at OS/container level: TZ=Asia/Jakarta
