# DSR ETL service configuration (dsr only -- split out of retry_scheduler,
# see eod_retry_scheduler/.env.example for dmaa/itm_cashpos/itm_replenish).
# Copy to .env and fill in real values. All variables use the DSR_ETL_ prefix
# (pydantic-settings env_prefix).

DSR_ETL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cms?sslmode=disable

DSR_ETL_AUTH_SECRET=change_me
DSR_ETL_AUTH_MODE=api_key

DSR_ETL_SLA_DSR=09:00

DSR_ETL_RETRY_INTERVAL_MINUTES=30
DSR_ETL_MAX_AUTO_RETRIES=3
DSR_ETL_DB_RETRY_MAX_ATTEMPTS=3
DSR_ETL_DB_RETRY_BASE_DELAY_SECONDS=1.0

DSR_ETL_SCAN_CRON_START_HOUR=5
DSR_ETL_SCAN_CRON_END_HOUR=9
DSR_ETL_SCAN_INTERVAL_MINUTES=15

DSR_ETL_FTP_DATA_ROOT=FTP_DATA
# DSR_ETL_DSR_INPUT_DIR=
# DSR_ETL_DSR_NOT_PROCESSED_DIR=

DSR_ETL_ETL_DSR_SCRIPT=scheduler/dsr/dsr_etl.py

DSR_ETL_SERVICE_VERSION=1.0.0
DSR_ETL_LOG_LEVEL=INFO
